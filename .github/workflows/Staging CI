staging-ci.yml:

name: Staging CI

on:
  pull_request:
    branches:
      - release
    types: [opened, synchronize, reopened]

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Install Dependencies
        run: npm install

      - name: Run Tests
        run: npm test

      - name: Build Project
        run: npm run build

      - name: Static Code Analysis
        run: echo "Running Code Analysis..."




